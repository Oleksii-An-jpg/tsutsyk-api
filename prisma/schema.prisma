datasource db {
  provider = "postgresql" // Or your preferred DB
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tsutsyk {
  id        String    @id @default(uuid())
  name      String?
  sessions  Session[]
  createdAt DateTime  @default(now())
}

model Session {
  id         String        @id
  tsutsykId  String
  tsutsyk    Tsutsyk       @relation(fields: [tsutsykId], references: [id])
  startTime  DateTime      @default(now())
  endTime    DateTime?
  status     SessionStatus @default(ACTIVE)
  locations  Location[]

  @@index([tsutsykId])
  @@index([status])
}

enum SessionStatus {
  ACTIVE
  COMPLETED
}

model Location {
  id         Int      @id @default(autoincrement())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id])
  latitude   Float
  longitude  Float
  battery    Int?
  timestamp  DateTime @default(now())

  @@index([sessionId])
  @@index([timestamp])
}