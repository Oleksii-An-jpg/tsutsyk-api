rules_version = '2';

// Tsutsyk profile photos, uploaded directly from the client app. Reads use
// Firebase's token-bearing download URLs (stored on the Tsutsyk doc), so
// they don't need to go through the auth check below. Writes are restricted
// to signed-in users and plain images under a sane size.
service firebase.storage {
  match /b/{bucket}/o {
    match /tsutsyk-photos/{tsutsykId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
