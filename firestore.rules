rules_version = '2';

// All access to this data goes through the NestJS API via the Admin SDK,
// which bypasses these rules. Client SDKs are never expected to talk to
// this database directly, so everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
