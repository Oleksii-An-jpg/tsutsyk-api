# ─── monobank internet acquiring ────────────────────────────────────────
# Merchant token from https://web.monobank.ua/ (Еквайринг та послуги → API),
# or a test token from https://api.monobank.ua/ for the sandbox.
#
# The sandbox needs no terminal and no approval — it is open to every bank
# client, and its payment page accepts any Luhn-valid card number. Check which
# one you have with `GET /api/merchant/details`: a `test_`-prefixed merchantId
# is the sandbox.
#
# Without it the order mutations answer 503 and the reconcile job stands down;
# everything else in the API runs as usual.
MONOBANK_ACQUIRING_TOKEN=

# Public origin of THIS API. monobank posts invoice callbacks to
# $API_PUBLIC_URL/payments/monobank/webhook, so it has to be reachable from the
# internet — monobank cannot POST to localhost. Use a tunnel in development.
# Unset, the origin of the request that opened the invoice is used instead,
# which covers preview deployments but not a local run behind a proxy.
API_PUBLIC_URL=https://api.tsutsyk.live

# Where a buyer is sent back to once they are done paying. Also the default
# `redirectUrl`, and the origin the basket icons are built from.
STOREFRONT_URL=https://tsutsyk.live

# Extra origins a client may ask to be redirected back to, comma-separated.
# The storefront is always allowed. Anything else is refused: the URL is handed
# to a bank that redirects a paying customer to it, so an unchecked one turns
# checkout into an open redirect.
# ORDER_REDIRECT_ORIGINS=http://localhost:3000,https://localhost:3000

# Optional. Override the API host (only useful for a local mock).
# MONOBANK_API_BASE=https://api.monobank.ua

# Optional. Override the price per environment, in kopiykas, so staging can
# charge 1 ₴ instead of the catalogue price.
# TSUTSYK_PRICE_KOPIYKAS=100

# Optional. Set to `false` to stop the half-hourly job that asks monobank
# about invoices whose webhook never arrived.
# ORDERS_RECONCILE_CRON=false

# ─── Firestore ──────────────────────────────────────────────────────────
# Named database this API talks to. Defaults to tsutsyk-firestore.
# FIRESTORE_DATABASE_ID=tsutsyk-firestore
